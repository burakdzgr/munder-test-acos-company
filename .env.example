# Mode-B (apps on host, infra in compose) localhost defaults — 27-INFRASTRUCTURE.md §3, 28 §7.
# Mode A overrides hostnames via compose environment (service DNS names).

# --- Core ---
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
WEB_PORT=5173
SERVER_PORT=3000
DATA_DIR=./data
LOG_LEVEL=info
SEED_DEMO=true

# --- Postgres (source of truth) ---
DATABASE_URL=postgres://acos:acos@localhost:5432/acos

# --- NATS JetStream ---
NATS_URL=nats://localhost:4222

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=acos

# --- Security ---
MASTER_KEY=                               # 32-byte base64; envelope encryption (libsodium); fill via: pnpm ops keygen
SESSION_SECRET=                           # cookie signing
AUTH_AUTOLOGIN=true                       # single-user mode: no login UI, Founder session auto-minted; "false" restores the login flow
ARGON2_MEMORY_KIB=65536

# --- LLM providers (any subset; ModelRouter uses what's configured; none => Ollama offline profile) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434              # Local Ollama (docker-compose'ta service olarak çalışıyor)
OLLAMA_PORT=11434                                    # Ollama container port mapping
OLLAMA_MODEL=mistral                                 # Model adı (mistral, llama2, neural-chat)
VLLM_BASE_URL=
ABACUS_API_KEY=                                      # AbacusAI API key (web.search tool için; https://abacus.ai/app/profile/apikey)

# --- Embeddings ---
EMBEDDINGS_PROVIDER=openai                # openai | ollama
EMBEDDINGS_MODEL=text-embedding-3-small   # nomic-embed-text for offline profile

# --- Sandbox / execution plane ---
SANDBOX_MANAGER_URL=http://localhost:3010
MAX_WORKSPACES=8
DOCKER_SOCK=/var/run/docker.sock          # mounted ONLY into sandbox-manager
EGRESS_PROXY_URL=http://egress-proxy:3128     # sandbox-manager always runs in Docker, even in Mode B

# --- Internal auth (server <-> workers/services) ---
INTERNAL_API_TOKEN=                       # shared bearer for internal HTTP (Tool Gateway, sandbox-manager)
SERVER_INTERNAL_URL=http://localhost:3000 # Tool Gateway endpoint for workers (compose sets http://server:3000)

# --- Observability (optional profile) ---
OTEL_EXPORTER_OTLP_ENDPOINT=              # empty => no-op exporter (observability profile only)
GRAFANA_ADMIN_PASSWORD=

# --- Budgets / safety defaults ---
DEFAULT_COMPANY_DAILY_BUDGET_CENTS=5000

# --- Backups ---
BACKUP_S3_URL=                            # optional rclone target
# --- LLM mode ---
# scripted = deterministic fake ModelRouter (e2e/demo, 32 §6); empty = live adapters
LLM_MODE=
